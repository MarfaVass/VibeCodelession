# ============================================================
# TEAM TASK MANAGER — шаблон конфигурации
# Скопируйте этот файл в .env и заполните свои значения.
# Файл .env исключён из Git (см. .gitignore) — не публикуйте его!
# ============================================================

# Токен бота, полученный у @BotFather в Telegram (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую (обязательно).
# Свой ID можно узнать у бота @userinfobot.
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Часовой пояс для отображения дат пользователям
TIMEZONE=Europe/Stockholm

# Путь к файлу базы данных SQLite
DATABASE_PATH=data/tasks.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Включить ли автоматическое резервное копирование при запуске
BACKUP_ENABLED=true
